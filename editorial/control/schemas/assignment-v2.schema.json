{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameFinder assignment v2",
  "type": "object",
  "required": ["schema_version", "assignment_id", "batch_id", "wave", "worker_id", "attempt", "state", "task_ids", "expected_paths", "base_sha", "branch", "worktree_path", "result_path", "created_at", "updated_at", "history"],
  "properties": {
    "schema_version": {"const": 2},
    "assignment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "batch_id": {"type": "string", "pattern": "^batch-[0-9]{4,}$"},
    "wave": {"type": "integer", "minimum": 1},
    "worker_id": {"enum": ["a", "b", "c", "d", "e"]},
    "attempt": {"type": "integer", "minimum": 1},
    "state": {"enum": ["ALLOCATED", "DISPATCHED", "RUNNING", "RESULT_READY", "REVIEW_PASSED", "INTEGRATED", "REVIEW_REJECTED", "INTERRUPTED", "BLOCKED", "FAILED"]},
    "task_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expected_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch": {"type": "string", "pattern": "^workers/batch-[0-9]{4,}/[a-e]-wave-[0-9]{3,}$"},
    "worktree_path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "result_path": {"type": "string", "pattern": "^editorial/results/v2/[a-z0-9-]+\\.json$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "history": {"type": "array"}
  }
}
