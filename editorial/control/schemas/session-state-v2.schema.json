{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameFinder session state v2",
  "type": "object",
  "required": ["schema_version", "session_id", "batch_id", "mode", "last_completed_phase", "outstanding_assignment_ids", "next_action", "classification", "execution_route", "worker_count", "dispatch_reason", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": 2},
    "session_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "batch_id": {"type": "string", "pattern": "^batch-[0-9]{4,}$"},
    "mode": {"enum": ["t", "a"]},
    "last_completed_phase": {"type": "string"},
    "outstanding_assignment_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}},
    "next_action": {"type": "string"},
    "classification": {"enum": ["local_script", "repository_change", "parallel_code_change", "content_generation", "article_writing", "content_application"]},
    "execution_route": {"enum": ["local-script", "codex-master", "codex-worker-wave", "external-content-input"]},
    "worker_count": {"type": "integer", "minimum": 0, "maximum": 3, "default": 0},
    "dispatch_reason": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"execution_route": {"const": "codex-worker-wave"}}}, "then": {"properties": {"classification": {"const": "parallel_code_change"}, "worker_count": {"minimum": 1, "maximum": 3}}}},
    {"if": {"not": {"properties": {"execution_route": {"const": "codex-worker-wave"}}}}, "then": {"properties": {"worker_count": {"const": 0}}}},
    {"if": {"properties": {"classification": {"enum": ["content_generation", "article_writing"]}}}, "then": {"properties": {"execution_route": {"const": "external-content-input"}, "worker_count": {"const": 0}}}},
    {"if": {"properties": {"classification": {"const": "content_application"}}}, "then": {"properties": {"execution_route": {"const": "codex-master"}}}},
    {"if": {"properties": {"classification": {"const": "local_script"}}}, "then": {"properties": {"execution_route": {"const": "local-script"}}}},
    {"if": {"properties": {"classification": {"const": "repository_change"}}}, "then": {"properties": {"execution_route": {"const": "codex-master"}}}},
    {"if": {"properties": {"execution_route": {"const": "external-content-input"}}}, "then": {"properties": {"classification": {"enum": ["content_generation", "article_writing"]}}}}
  ]
}
