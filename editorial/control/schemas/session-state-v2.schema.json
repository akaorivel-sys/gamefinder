{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameFinder session state v2",
  "type": "object",
  "required": ["schema_version", "session_id", "batch_id", "mode", "last_completed_phase", "outstanding_assignment_ids", "next_action", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": 2},
    "session_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "batch_id": {"type": "string", "pattern": "^batch-[0-9]{4,}$"},
    "mode": {"enum": ["t", "a"]},
    "last_completed_phase": {"type": "string"},
    "outstanding_assignment_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}},
    "next_action": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
