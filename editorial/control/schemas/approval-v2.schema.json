{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameFinder approval v2",
  "type": "object",
  "required": ["schema_version", "batch_id", "status", "integration_branch", "integration_head", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": 2},
    "batch_id": {"type": "string", "pattern": "^batch-[0-9]{4,}$"},
    "status": {"enum": ["PENDING", "APPROVED", "REJECTED"]},
    "integration_branch": {"type": "string", "pattern": "^integration/batch-[0-9]{4,}$"},
    "integration_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "actor": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["APPROVED", "REJECTED"]}}},
      "then": {"required": ["actor", "reason", "decided_at"]}
    }
  ]
}
